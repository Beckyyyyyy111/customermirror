OPENAI_API_KEY=sk-your-key-here

# Optional — switches persona/coach/synthesis text generation to Gemini instead of
# OpenAI. Audio (speech-to-text/text-to-speech) always uses OPENAI_API_KEY above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional — number of AI customer/investor personas generated per session
CANDIDATE_CUSTOMER_COUNT=3
CANDIDATE_INVESTOR_COUNT=2

# Optional — HeyGen LiveAvatar cloud digital human (paid, metered). If unset, the
# app falls back to a free self-hosted local avatar or a built-in animated face.
LIVEAVATAR_API_KEY=your-liveavatar-api-key
LIVEAVATAR_AVATAR_ID=your-liveavatar-id
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_SANDBOX=true
